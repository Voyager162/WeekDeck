rules_version = '2';
// Owner-written users/{uid}: blocks (validated times/content, immutable createdAt),
// templates (title/color/icon/duration), days (enabled/start/end), settings/planner
// (appearance, snapping, notifications). All writes require server updatedAt.
// Optional dayHours: {start,end,linked,version}; days.hoursVersion matches a UUID.
// Legacy documents may omit these shared-hours fields. No public user documents.
// scheduleShares/{ownerUid}_{recipientEmail}: verified email invitations with
// ownerUid/ownerEmail/recipientEmail, bound recipientUid, pending/accepted/declined
// status, week/all scope, week/endDay dates, startAt/endAt milliseconds, timeZone,
// server updatedAt. Accepted recipients can read only the authorized schedule.
// settings/shared projects weekStart/dayHours/timeZone without private preferences.
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function activeOwner(uid) {
      return owner(uid) && !exists(/databases/$(database)/documents/accountDeletions/$(uid));
    }
    // Invitations are private to their sender and verified recipient. Acceptance binds a UID.
    function verifiedEmail() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function recipient(data) {
      return verifiedEmail() && data.recipientEmail == request.auth.token.email.lower();
    }
    function grant(uid) {
      return get(/databases/$(database)/documents/scheduleShares/$(uid + '_' + request.auth.token.email.lower())).data;
    }
    function sharedWith(uid) {
      return verifiedEmail()
        && !exists(/databases/$(database)/documents/accountDeletions/$(uid))
        && grant(uid).status == 'accepted'
        && grant(uid).recipientUid == request.auth.uid;
    }
    function sharedBlock(uid) {
      return sharedWith(uid) && (grant(uid).scope == 'all'
        || (resource.data.startAt >= grant(uid).startAt && resource.data.startAt < grant(uid).endAt));
    }
    function sharedDay(uid, day) {
      return sharedWith(uid) && (grant(uid).scope == 'all'
        || (day >= grant(uid).week && day < grant(uid).endDay));
    }
    function validShare(data, id) {
      return fields(data, ['ownerUid', 'ownerEmail', 'recipientEmail', 'recipientUid', 'status', 'scope', 'week', 'endDay', 'startAt', 'endAt', 'timeZone', 'updatedAt'])
        && data.ownerUid is string && data.ownerEmail is string
        && data.recipientEmail is string && data.recipientEmail.size() <= 254
        && data.recipientEmail.matches('^[^ /@]+@[^ /@]+[.][^ /@]+$')
        && data.recipientEmail == data.recipientEmail.lower()
        && data.recipientEmail != data.ownerEmail
        && id == data.ownerUid + '_' + data.recipientEmail
        && data.recipientUid is string && data.recipientUid.size() <= 128
        && data.status in ['pending', 'accepted', 'declined']
        && data.scope in ['week', 'all']
        && data.week is string && data.week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.endDay is string && data.endDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.endDay > data.week
        && data.startAt is int && data.startAt >= 0 && data.endAt is int
        && data.endAt - data.startAt >= 601200000 && data.endAt - data.startAt <= 608400000
        && data.timeZone is string && data.timeZone.size() <= 100
        && data.updatedAt == request.time;
    }
    match /scheduleShares/{id} {
      allow read: if owner(resource.data.ownerUid) || recipient(resource.data)
        || (request.auth != null && resource.data.recipientUid == request.auth.uid);
      allow create: if validShare(request.resource.data, id)
        && activeOwner(request.resource.data.ownerUid) && verifiedEmail()
        && request.resource.data.ownerEmail == request.auth.token.email.lower()
        && request.resource.data.status == 'pending' && request.resource.data.recipientUid == '';
      allow update: if validShare(request.resource.data, id)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.recipientEmail == resource.data.recipientEmail
        && ((activeOwner(resource.data.ownerUid) && verifiedEmail()
          && request.resource.data.ownerEmail == request.auth.token.email.lower()
          && request.resource.data.status == 'pending' && request.resource.data.recipientUid == '')
        || (recipient(resource.data) && activeOwner(request.auth.uid)
          && resource.data.status == 'pending'
          && request.resource.data.status in ['accepted', 'declined']
          && request.resource.data.recipientUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'recipientUid', 'updatedAt'])));
      allow delete: if owner(resource.data.ownerUid) || recipient(resource.data)
        || (request.auth != null && resource.data.recipientUid == request.auth.uid);
    }
    match /accountDeletions/{uid} {
      allow get: if owner(uid);
      allow create: if owner(uid)
        && request.auth.token.auth_time is int
        && request.auth.token.auth_time * 1000 <= request.time.toMillis()
        && request.time.toMillis() - request.auth.token.auth_time * 1000 < 300000
        && request.resource.data.keys().hasOnly(['requestedAt'])
        && request.resource.data.requestedAt == request.time;
      allow list, update, delete: if false;
    }
    function fields(data, names) {
      return data.keys().hasAll(names) && data.keys().hasOnly(names);
    }
    function color(value) {
      return value in ['teal', 'blue', 'violet', 'rose', 'amber', 'green', 'cyan', 'gray'];
    }
    function validBlock(data) {
      return data.keys().hasAll(['title', 'notes', 'category', 'startAt', 'endAt', 'completed', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'notes', 'category', 'color', 'startAt', 'endAt', 'completed', 'createdAt', 'updatedAt'])
        && (!('color' in data) || color(data.color))
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.notes is string && data.notes.size() <= 2000
        && data.category in ['focus', 'meeting', 'personal', 'break']
        && data.startAt is int && data.startAt >= 0
        && data.endAt is int && data.endAt > data.startAt
        && data.endAt - data.startAt <= 86400000
        && data.completed is bool
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    match /users/{uid}/blocks/{blockId} {
      allow read: if owner(uid) || sharedBlock(uid);
      allow delete: if owner(uid);
      allow create: if activeOwner(uid) && validBlock(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if activeOwner(uid) && validBlock(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    // Reusable presets contain no ownership or privilege fields.
    function validTemplate(data) {
      return fields(data, ['title', 'color', 'icon', 'duration', 'updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 80
        && color(data.color)
        && data.icon in ['book', 'briefcase', 'coffee', 'music', 'pencil', 'heart', 'dumbbell', 'sparkles']
        && data.duration is int && data.duration >= 15 && data.duration <= 240
        && data.updatedAt == request.time;
    }
    match /users/{uid}/templates/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if activeOwner(uid) && validTemplate(request.resource.data);
    }
    // Per-date planning hours use local wall-clock minutes; blocks store instants.
    function hoursVersion(value) {
      return value is string && value.size() == 36
        && value.matches('^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$');
    }
    function validDay(data) {
      return data.keys().hasAll(['enabled', 'start', 'end', 'updatedAt'])
        && data.keys().hasOnly(['enabled', 'start', 'end', 'hoursVersion', 'updatedAt'])
        && (!('hoursVersion' in data) || hoursVersion(data.hoursVersion))
        && data.enabled is bool && data.start is int && data.end is int
        && data.start >= 0 && data.end <= 1440 && data.end - data.start >= 15
        && data.updatedAt == request.time;
    }
    match /users/{uid}/days/{day} {
      allow read: if owner(uid) || sharedDay(uid, day);
      allow delete: if owner(uid);
      allow create, update: if activeOwner(uid) && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && validDay(request.resource.data);
    }
    function validNotifications(data) {
      return data is map
        && fields(data, ['planning', 'day', 'time', 'advanced', 'end', 'interval', 'transitions', 'lead'])
        && data.planning is bool && data.advanced is bool && data.transitions is bool
        && data.day is int && data.day >= 0 && data.day <= 6
        && data.time is int && data.time >= 0 && data.time < 1440
        && data.end is int && data.end >= 0 && data.end < 1440
        && data.interval in [15, 30, 45, 60, 90, 120]
        && data.lead in [0, 5, 10]
        && (!data.advanced || (data.end >= data.time && data.end - data.time <= 240));
    }
    function validSettings(data) {
      return data.keys().hasAll(['theme', 'hourHeight', 'snap', 'timeFormat', 'weekStart', 'notifications', 'updatedAt'])
        && data.keys().hasOnly(['theme', 'hourHeight', 'snap', 'timeFormat', 'weekStart', 'notifications', 'dayHours', 'updatedAt'])
        && (!('dayHours' in data) || validSharedHours(data.dayHours))
        && data.theme in ['light', 'dark', 'sage', 'rose', 'system']
        && data.hourHeight is int && data.hourHeight >= 48 && data.hourHeight <= 100
        && data.snap in [5, 15, 30] && data.timeFormat in ['12', '24']
        && data.weekStart in [0, 1] && validNotifications(data.notifications)
        && data.updatedAt == request.time;
    }
    function validSharedHours(data) {
      return data is map && fields(data, ['start', 'end', 'linked', 'version'])
        && data.start is int && data.end is int
        && data.start >= 0 && data.end <= 1440 && data.end - data.start >= 15
        && data.linked is bool && hoursVersion(data.version);
    }
    match /users/{uid}/settings/planner {
      allow read: if owner(uid);
      allow create, update: if activeOwner(uid) && validSettings(request.resource.data);
      allow delete: if owner(uid);
    }
    // Only schedule layout is shared; notification and appearance settings stay private.
    match /users/{uid}/settings/shared {
      allow read: if owner(uid) || sharedWith(uid);
      allow create, update: if activeOwner(uid)
        && fields(request.resource.data, ['weekStart', 'dayHours', 'timeZone', 'updatedAt'])
        && request.resource.data.weekStart in [0, 1]
        && (request.resource.data.dayHours == null || validSharedHours(request.resource.data.dayHours))
        && request.resource.data.timeZone is string && request.resource.data.timeZone.size() <= 100
        && request.resource.data.updatedAt == request.time;
      allow delete: if owner(uid);
    }
    // All other paths are private until an explicit schema and rule are added.
    match /{document=**} { allow read, write: if false; }
  }
}
