{
  "name": "weekdeck",
  "version": "0.1.0",
  "private": true,
  "description": "A personal time-blocking planner for mobile and desktop.",
  "author": "Weston Gardner",
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/domain.test.ts tests/planner.test.ts",
    "test:rules": "firebase emulators:exec --project demo-timeblocker --only firestore \"vitest run tests/firestore.rules.test.ts\"",
    "test:e2e": "playwright test",
    "test:sync": "firebase emulators:exec --project demo-timeblocker --only auth,firestore \"playwright test\"",
    "emulators": "firebase emulators:start --project demo-timeblocker --only auth,firestore",
    "dev:emulators": "vite --mode emulator --host 127.0.0.1",
    "firebase:login": "firebase login",
    "firebase:select": "firebase use --add",
    "deploy:rules": "firebase deploy --only firestore",
    "deploy:web": "npm run build && firebase deploy --only hosting",
    "mobile:sync": "npm run build && cap sync",
    "android": "cap open android",
    "ios": "cap open ios",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/local-notifications": "8.3.1",
    "@dnd-kit/core": "6.3.1",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "firebase": "12.19.0",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "firebase-tools": "15.31.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  },
  "build": {
    "appId": "com.voyager162.timeblocker",
    "productName": "Weekdeck",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
